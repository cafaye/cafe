# anywaye.yml — {{ .Name }}: a anywaye app scaffolded by `cafe new --template app`.
#
# This file is the app's IDENTITY and never its configuration. Core's schema is
# `additionalProperties: false`, so a credential written here is a lint failure
# rather than a secret committed to a repository — service environment arrives
# per deployment, by reference. Owner and repository are the two facts cafe
# cannot know; edit them.
#
# Checked against core's manifest schema and the conventions with:
#
#   cafe contract lint .
name: {{ .Name }}
description: A anywaye app scaffolded by cafe new.

language: go

# The core contract version this app is written against. `cafe contract
# resolve 0.2.0` answers whether a given version is inside this range.
core: {{ .CoreConstraint }}

# `exposes` is deliberately absent: a scaffolded app publishes nothing yet.
# When this app serves an API or publishes events, declare them here — every
# event type opens with the publisher's own name — and `cafe contract lint`
# will hold this manifest to it.
repository:
  url: {{ .RepositoryURL }}
  defaultBranch: master
  visibility: private

owner:
  # The team accountable for this app, not its author.
  team: {{ .OwnerTeam }}
